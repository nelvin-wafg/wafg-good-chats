# copy this file to .env.local and fill in real values.
# in vercel, paste these into Project Settings > Environment Variables.

# --- supabase ---
# get these from supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- daily.co ---
# get from daily dashboard > Developers
DAILY_API_KEY=your-daily-api-key-here
DAILY_DOMAIN=wafg

# --- app ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- secrets ---
# SESSION_SECRET is used to sign participant identity + profile cookies (HMAC-SHA256).
# must be at least 32 characters. generate a fresh random string per environment.
# easy ways to make one:
#   - 1password / bitwarden password generator (length 64+, all chars)
#   - or visit https://generate-secret.vercel.app/64
#   - or any long random string of your own making
# treat this like a password. don't commit the real value. keep it out of git.
SESSION_SECRET=your-32-plus-character-random-string-here

# --- kit (newsletter) ---
# when participants opt in to the WAFG newsletter, we add their email here.
# get your KIT_API_KEY from kit.com → Account → Settings → Developer.
# get your KIT_FORM_ID from kit.com → Grow → Landing Pages & Forms → pick the form → settings → embed → it's the number after /forms/
# if either of these is missing, the join flow still works · we just skip the kit sync.
KIT_API_KEY=your-kit-api-key-here
KIT_FORM_ID=1234567
